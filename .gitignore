# Reference clones used for research only — never part of the product.
# Keeping them out of git prevents accidentally shipping another project's source.
.tmp/

# Python venv used only to run schemas/validate.py
.venv-schema/

# Build/test artifacts
/target/
/bin/
# Stray build output at the repo root (go build ./cmd/mempilot drops one here)
/mempilot
/mempilotd
*.exe
*.test
coverage.out

# Local data
*.log
.DS_Store
